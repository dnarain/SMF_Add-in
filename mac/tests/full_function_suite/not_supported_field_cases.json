  {
    "id": "NotSupported_FieldWorksheetNA",
    "function": "RCHGetElementNumber",
    "module": "modGetElementNumber.bas",
    "group": "not_supported_fields",
    "description": "A real numbered-field worksheet formula returns Excel#N/A even with a custom ordinary-error fallback.",
    "declarations": [
      "Dim nsCallsBefore As Double, nsRequestsBefore As Double, nsCallsAfter As Double, nsRequestsAfter As Double",
      "Dim nsOldInit As Integer, nsOldError As Variant, nsPriorURL As String, nsPriorError As String, nsPriorStatus As Long",
      "Dim nsOK As Boolean",
      "Dim nsRange As Range, nsFormula As Variant, nsFormat As Variant, nsSource As Variant"
    ],
    "setup": [
      "nsOldInit = iInit",
      "nsOldError = vError",
      "nsPriorURL = SMFMacLastURL()",
      "nsPriorError = SMFMacLastError()",
      "nsPriorStatus = SMFMacHTTPStatus()",
      "Call SMFMacRequestCounts(nsCallsBefore, nsRequestsBefore)",
      "nsSource = RCHGetElementNumber(\"SOURCE\", 4072)",
      "Set nsRange = ThisWorkbook.Worksheets(\"TestInputs\").Range(\"J42\")",
      "nsFormula = nsRange.Formula2",
      "nsFormat = nsRange.NumberFormat",
      "nsRange.ClearContents",
      "nsRange.NumberFormat = \"General\"",
      "nsRange.Formula2 = \"=RCHGetElementNumber(\"\"AAPL\"\",625,\"\"CUSTOM_FALLBACK\"\")\"",
      "nsRange.Calculate"
    ],
    "expression": "nsRange.Value2",
    "check_setup": [
      "nsOK = False",
      "If IsError(result) Then nsOK = (CStr(result) = CStr(CVErr(xlErrNA)))",
      "Call SMFMacRequestCounts(nsCallsAfter, nsRequestsAfter)"
    ],
    "check": "(nsOK) And nsCallsAfter = nsCallsBefore And nsRequestsAfter = nsRequestsBefore And SMFMacLastURL() = nsPriorURL And SMFMacLastError() = nsPriorError And SMFMacHTTPStatus() = nsPriorStatus",
    "expected_text": "A real numbered-field worksheet formula returns Excel#N/A even with a custom ordinary-error fallback.; zero downloader entries and fetchURL bridge attempts.",
    "cleanup": [
      "nsRange.Formula2 = nsFormula",
      "nsRange.NumberFormat = nsFormat",
      "iInit = nsOldInit",
      "vError = nsOldError"
    ],
    "network": false,
    "test_mode": "unsupported_guard_fixture",
    "worksheet_formula": "=RCHGetElementNumber(\"AAPL\",625,\"CUSTOM_FALLBACK\")",
    "expected_not_supported": true,
    "support_id": "obsolete-definition"
  },
