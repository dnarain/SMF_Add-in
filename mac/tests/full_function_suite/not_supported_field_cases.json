  {
    "id": "NotSupported_StatusWorkbook",
    "function": "smfShowSourceStatus",
    "module": "modGetElementNumber.bas",
    "group": "not_supported_fields",
    "description": "The menu macro creates an unsaved, text-formatted status workbook with the6retired source groups and288loaded fields, and no formulas.",
    "declarations": [
      "Dim nsCallsBefore As Double, nsRequestsBefore As Double, nsCallsAfter As Double, nsRequestsAfter As Double",
      "Dim nsOldInit As Integer, nsOldError As Variant, nsPriorURL As String, nsPriorError As String, nsPriorStatus As Long",
      "Dim nsOK As Boolean",
      "Dim nsRows As Variant, nsBook As Workbook, nsSheet As Worksheet, nsCell As Range, nsSource As Variant"
    ],
    "setup": [
      "nsOldInit = iInit",
      "nsOldError = vError",
      "nsPriorURL = SMFMacLastURL()",
      "nsPriorError = SMFMacLastError()",
      "nsPriorStatus = SMFMacHTTPStatus()",
      "Call SMFMacRequestCounts(nsCallsBefore, nsRequestsBefore)",
      "nsSource = RCHGetElementNumber(\"SOURCE\", 4072)",
      "Call smfShowSourceStatus",
      "Set nsBook = ActiveWorkbook",
      "If nsBook Is ThisWorkbook Then Err.Raise 5, , \"Status macro did not create a separate workbook\"",
      "Set nsSheet = nsBook.Worksheets(\"SMFSourceStatus\")",
      "nsRows = nsSheet.UsedRange.Value2"
    ],
    "expression": "nsRows",
    "check_setup": [
      "nsOK = False",
      "If IsArray(result) Then",
      "nsOK = (UBound(result, 1) = 295 And UBound(result, 2) = 9)",
      "End If",
      "If nsSheet.ListObjects.Count <> 1 Then nsOK = False",
      "If Not nsSheet.ListObjects(\"SMFSourceStatusTable\").ShowAutoFilter Then nsOK = False",
      "If nsBook.Path <> \"\" Then nsOK = False",
      "If CStr(nsSheet.Range(\"E1\").Value2) <> \"Status\" Then nsOK = False",
      "If CStr(nsSheet.Range(\"I1\").Value2) <> \"Reviewed\" Then nsOK = False",
      "For Each nsCell In nsSheet.UsedRange",
      "If nsCell.HasFormula Then nsOK = False",
      "If nsCell.NumberFormat <> \"@\" Then nsOK = False",
      "Next nsCell",
      "Call SMFMacRequestCounts(nsCallsAfter, nsRequestsAfter)"
    ],
    "check": "(nsOK) And nsCallsAfter = nsCallsBefore And nsRequestsAfter = nsRequestsBefore And SMFMacLastURL() = nsPriorURL And SMFMacLastError() = nsPriorError And SMFMacHTTPStatus() = nsPriorStatus",
    "expected_text": "The menu macro creates an unsaved, text-formatted status workbook with the6retired source groups and288loaded fields, and no formulas.; zero downloader entries and fetchURL bridge attempts.",
    "cleanup": [
      "If Not nsBook Is Nothing Then",
      "If Not nsBook Is ThisWorkbook Then nsBook.Close SaveChanges:=False",
      "End If",
      "ThisWorkbook.Activate",
      "iInit = nsOldInit",
      "vError = nsOldError"
    ],
    "network": false,
    "test_mode": "unsupported_guard_fixture",
    "auxiliary": true,
    "procedure_kind": "Sub"
  },
  {
