      "Call SMFMacRequestCounts(nsCallsBefore, nsRequestsBefore)",
      "nsCases = Array(1, 2, 3, 4, 5, 6, 7, 8)",
      "nsOK = True",
      "Call smfUnsupportedURL(\"https://name@query.yahooapis.com/v1/public/yql?q=x\", nsID, nsReason)",
      "If nsID <> \"yahoo-yql\" Then nsOK = False",
      "Call smfUnsupportedURL(\"https://query.yahooapis.com@allowed.invalid/v1/public/yql\", nsID, nsReason)",
      "If nsID <> \"\" Then nsOK = False",
      "If nsReason <> \"\" Then nsOK = False",
