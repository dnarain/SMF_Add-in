      "nsPriorError = SMFMacLastError()",
      "nsPriorStatus = SMFMacHTTPStatus()",
      "Call SMFMacRequestCounts(nsCallsBefore, nsRequestsBefore)",
      "iInit = 0",
      "Call smfUnsupportedRows(nsRows)"
    ],
    "expression": "nsRows",
    "check_setup": [
      "nsOK = (iInit = 0)",
      "If Not IsArray(result) Then",
