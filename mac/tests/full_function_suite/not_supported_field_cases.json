    "group": "not_supported_fields",
    "description": "Lookup-only URL controls match the real retired host and exact path while preserving unrelated hosts, paths and modernYahoo URLs.",
    "declarations": [
      "Dim nsCallsBefore As Double, nsRequestsBefore As Double, nsCallsAfter As Double, nsRequestsAfter As Double",
      "Dim nsOldInit As Integer, nsOldError As Variant, nsPriorURL As String, nsPriorError As String, nsPriorStatus As Long",
