  {
    "id": "GetKeys",
    "function": "GetKeys",
    "group": "json_core",
    "description": "GetKeys returns a zero-based native String array and preserves numeric-looking object keys.",
    "declarations": [
      "Dim jsonKeysFixture As Object"
    ],
    "setup": [
      "Set jsonKeysFixture = JsonConverter.ParseJson(\"{\"\"0\"\":\"\"zero\"\",\"\"01\"\":\"\"leading\"\"}\")"
    ],
    "expression": "GetKeys(jsonKeysFixture)",
    "object_result": false,
    "check": "IsArray(result) And LBound(result) = 0 And UBound(result) = 1 And CStr(result(0)) = \"0\" And CStr(result(1)) = \"01\"",
    "expected_text": "Native array indexed 0..1 containing 0 and 01",
    "cleanup": [
      "Set jsonKeysFixture = Nothing"
    ],
    "module": "modJSONExtract.bas"
  },
