[
  {
    "id": "ParseJson",
    "function": "ParseJson",
    "group": "json_core",
    "description": "JsonConverter.ParseJson preserves numbers, false, null, and a 19-digit identifier in a Dictionary.",
    "declarations": [
      "Dim jsonOldLarge As Boolean"
    ],
    "setup": [
      "jsonOldLarge = JsonConverter.JsonOptions.UseDoubleForLargeNumbers",
      "JsonConverter.JsonOptions.UseDoubleForLargeNumbers = False"
    ],
    "expression": "JsonConverter.ParseJson(\"{\"\"n\"\":7,\"\"flag\"\":false,\"\"nil\"\":null,\"\"id\"\":1234567890123456789}\")",
    "object_result": true,
    "check": "TypeName(obj) = \"Dictionary\" And obj.Count = 4 And CDbl(obj.Item(\"n\")) = 7 And VarType(obj.Item(\"flag\")) = vbBoolean And CBool(obj.Item(\"flag\")) = False And IsNull(obj.Item(\"nil\")) And VarType(obj.Item(\"id\")) = vbString And CStr(obj.Item(\"id\")) = \"1234567890123456789\"",
    "expected_text": "Dictionary with n=7, Boolean False, Null, and identifier text 1234567890123456789",
    "cleanup": [
      "JsonConverter.JsonOptions.UseDoubleForLargeNumbers = jsonOldLarge"
    ],
    "module": "JsonConverter.bas"
  },
  {
    "id": "ConvertToJson",
    "function": "ConvertToJson",
    "group": "json_core",
    "description": "JsonConverter.ConvertToJson serializes a native Variant array with numeric, Boolean, and Null values.",
    "declarations": [],
    "setup": [],
    "expression": "JsonConverter.ConvertToJson(Array(7, False, Null))",
    "object_result": false,
    "check": "VarType(result) = vbString And CStr(result) = \"[7,false,null]\"",
    "expected_text": "[7,false,null]",
    "cleanup": [],
    "module": "JsonConverter.bas"
  },
  {
    "id": "ParseUtc",
    "function": "ParseUtc",
    "group": "json_core",
    "description": "JsonConverter.ParseUtc converts a winter UTC timestamp to the verified America/Los_Angeles host timezone.",
    "declarations": [
      "Dim jsonUtcFixture As Date"
    ],
    "setup": [
      "jsonUtcFixture = DateSerial(2024, 1, 15) + TimeSerial(20, 0, 0)"
    ],
    "expression": "JsonConverter.ParseUtc(jsonUtcFixture)",
    "object_result": false,
    "check": "VarType(result) = vbDate And CDbl(result) = CDbl(DateSerial(2024, 1, 15) + TimeSerial(12, 0, 0))",
    "expected_text": "2024-01-15 12:00:00 PST; requires the verified America/Los_Angeles host timezone",
    "cleanup": [],
    "module": "JsonConverter.bas",
    "requires": [
      "host_timezone_America_Los_Angeles"
    ],
    "implementation_note": "The existing Mac implementation invokes macOS date through libc popen/fread; the expected winter PST offset was independently verified by the root agent."
  },
  {
    "id": "ConvertToUtc",
    "function": "ConvertToUtc",
    "group": "json_core",
    "description": "JsonConverter.ConvertToUtc converts winter noon in the verified America/Los_Angeles host timezone to UTC.",
    "declarations": [
      "Dim jsonLocalFixture As Date"
    ],
    "setup": [
      "jsonLocalFixture = DateSerial(2024, 1, 15) + TimeSerial(12, 0, 0)"
    ],
    "expression": "JsonConverter.ConvertToUtc(jsonLocalFixture)",
    "object_result": false,
    "check": "VarType(result) = vbDate And CDbl(result) = CDbl(DateSerial(2024, 1, 15) + TimeSerial(20, 0, 0))",
    "expected_text": "2024-01-15 20:00:00 UTC; requires the verified America/Los_Angeles host timezone",
    "cleanup": [],
    "module": "JsonConverter.bas",
    "requires": [
      "host_timezone_America_Los_Angeles"
    ],
    "implementation_note": "The existing Mac implementation invokes macOS date through libc popen/fread; the expected winter PST offset was independently verified by the root agent."
  },
  {
    "id": "ParseIso",
    "function": "ParseIso",
    "group": "json_core",
    "description": "JsonConverter.ParseIso parses a leap-day date without a time or timezone conversion.",
    "declarations": [],
