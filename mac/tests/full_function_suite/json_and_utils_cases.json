    "expression": "JsonConverter.ParseIso(\"2024-02-29\")",
    "object_result": false,
    "check": "VarType(result) = vbDate And CDbl(result) = CDbl(DateSerial(2024, 2, 29))",
    "expected_text": "2024-02-29 00:00:00",
    "cleanup": [],
    "module": "JsonConverter.bas"
  },
  {
    "id": "ConvertToIso",
    "function": "ConvertToIso",
    "group": "json_core",
    "description": "JsonConverter.ConvertToIso formats winter noon in the verified America/Los_Angeles host timezone as a UTC ISO timestamp.",
    "declarations": [
      "Dim jsonIsoLocalFixture As Date"
    ],
    "setup": [
      "jsonIsoLocalFixture = DateSerial(2024, 1, 15) + TimeSerial(12, 0, 0)"
    ],
    "expression": "JsonConverter.ConvertToIso(jsonIsoLocalFixture)",
    "object_result": false,
    "check": "VarType(result) = vbString And CStr(result) = \"2024-01-15T20:00:00.000Z\"",
    "expected_text": "2024-01-15T20:00:00.000Z; requires the verified America/Los_Angeles host timezone",
    "cleanup": [],
    "module": "JsonConverter.bas",
    "requires": [
      "host_timezone_America_Los_Angeles"
    ],
    "implementation_note": "The existing Mac implementation invokes macOS date through libc popen/fread; the expected winter PST offset was independently verified by the root agent."
  },
  {
    "id": "DecodeJsonString",
    "function": "DecodeJsonString",
    "group": "json_core",
    "description": "DecodeJsonString returns a Collection for a root JSON array and preserves its item order.",
    "declarations": [],
    "setup": [],
    "expression": "DecodeJsonString(\"[{\"\"name\"\":\"\"first\"\"},{\"\"name\"\":\"\"second\"\"}]\")",
    "object_result": true,
    "check": "TypeName(obj) = \"Collection\" And obj.Count = 2 And CStr(obj.Item(1).Item(\"name\")) = \"first\" And CStr(obj.Item(2).Item(\"name\")) = \"second\"",
    "expected_text": "Collection with two Dictionary items named first and second",
    "cleanup": [],
    "module": "modJSONExtract.bas"
  },
