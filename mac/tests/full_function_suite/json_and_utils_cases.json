    "id": "RCHGetURLData1Mac",
    "function": "RCHGetURLData1Mac",
    "module": "modMacCode.bas",
    "group": "json_and_utils",
    "description": "Fetch a known ASCII body from the loopback fixture server.",
    "declarations": [
      "Dim testOldLog As String"
    ],
    "setup": [
      "testOldLog = sLog",
      "sLog = \"N\""
    ],
    "expression": "RCHGetURLData1Mac(\"{{LOCAL_HTTP_BASE}}/text\", 0)",
    "object_result": false,
    "check": "CStr(result) = \"SMF fixture response\" And SMFMacHTTPStatus() = 200",
    "expected_text": "HTTP 200; exact body SMF fixture response",
    "cleanup": [
      "sLog = testOldLog"
    ],
    "requires": [
      "local_http_server"
    ],
    "coverage_note": "Confirms the Mac path using loopback HTTP; this does not test Windows IE/HTMLDocument/WinHTTP implementations or Yahoo authentication."
  },
