    "id": "fnWait",
    "function": "fnWait",
    "module": "smfUtilities_.bas",
    "group": "json_and_utils",
    "description": "Wait approximately one second and retain the function's Empty return.",
    "declarations": [
      "Dim testStarted As Double"
    ],
    "setup": [
      "testStarted = Timer"
    ],
    "expression": "fnWait(1)",
    "object_result": false,
    "check": "IsEmpty(result) And (((Timer - testStarted) >= 0.9) Or ((Timer < testStarted) And ((Timer + 86400# - testStarted) >= 0.9)))",
    "expected_text": "Empty return after at least0.9seconds",
    "cleanup": [],
    "requires": [
      "run_before_local_23_59_58"
    ],
    "coverage_note": "The function itself does not handle Timer crossing midnight; do not start within the last two seconds of the local day."
  },
