    "description": "smfGetOptionExpirations reads two Yahoo expiration timestamps from an offline response with explicit output dimensions.",
    "declarations": [
      "Dim optionsOldKeys(1 To 1) As String",
      "Dim optionsOldBodies(1 To 1) As String",
      "Dim optionsOldSData(1 To 3) As String",
      "Dim optionsCacheIndex As Long",
