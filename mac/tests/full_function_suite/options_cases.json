      "optionsOldBodies(optionsCacheIndex) = aData(optionsCacheIndex, 2)",
      "Next optionsCacheIndex",
      "For optionsCacheIndex = 1 To 3",
      "optionsOldSData(optionsCacheIndex) = sData(optionsCacheIndex)",
      "Next optionsCacheIndex",
